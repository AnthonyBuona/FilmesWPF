<Window x:Class="FilmesWPF.Views.CadastrarFilmeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastrar Filme" Height="490" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BrushBg}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeader" Grid.Row="0" Text="Novo Filme" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Título *" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
            <TextBox x:Name="TxtTitulo" Height="34" Margin="0,4,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Gênero *" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="TxtGenero" Height="34" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ano *" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="TxtAno" Height="34" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Diretor" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
            <TextBox x:Name="TxtDiretor" Height="34" Margin="0,4,0,12"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Duração (min) *" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="TxtDuracao" Height="34" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Nota (0.0 a 10.0) *" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox x:Name="TxtNota" Height="34" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancelar" Style="{StaticResource BtnOutline}" Margin="0,0,10,0" Click="BtnCancelar_Click" IsCancel="True"/>
            <Button Content="Salvar" Style="{StaticResource BtnPrimary}" Width="110" Height="36" Click="BtnSalvar_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
