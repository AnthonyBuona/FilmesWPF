<Window x:Class="FilmesWPF.Views.ListarFilmesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filmes Cadastrados" Height="540" Width="900"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BrushBg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
            <TextBlock Text="Catálogo de Filmes" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="TxtTotal" FontSize="13" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="DgFilmes" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                <DataGridTextColumn Header="Gênero" Binding="{Binding Genero}" Width="150"/>
                <DataGridTextColumn Header="Ano" Binding="{Binding Ano}" Width="70"/>
                <DataGridTextColumn Header="Diretor" Binding="{Binding Diretor}" Width="170"/>
                <DataGridTextColumn Header="Duração" Binding="{Binding DuracaoMin, StringFormat='{}{0} min'}" Width="110"/>
                <DataGridTextColumn Header="Nota" Binding="{Binding Nota, StringFormat='★ {0:0.0}'}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Editar" Style="{StaticResource BtnEdit}" Width="100" Height="34" Click="BtnEditar_Click"/>
            <Button Content="Excluir" Style="{StaticResource BtnDanger}" Width="100" Height="34" Margin="8,0,0,0" Click="BtnExcluir_Click"/>
            <Button Content="Voltar" Style="{StaticResource BtnOutline}" Width="100" Height="34" Margin="8,0,0,0" Click="BtnVoltar_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
