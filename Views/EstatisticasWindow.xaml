<Window x:Class="FilmesWPF.Views.EstatisticasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estatísticas" Height="460" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BrushBg}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Estatísticas do Catálogo" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushCard}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="TxtTotal" FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Total Filmes" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource BrushCard}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="TxtGeneros" FontSize="26" FontWeight="Black" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                    <TextBlock Text="Gêneros" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource BrushCard}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="TxtMedia" FontSize="26" FontWeight="Black" Foreground="{StaticResource BrushGold}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Nota Média" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushCard}" CornerRadius="10" Padding="16" Margin="0,16,0,0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Filmes por gênero" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                <ListBox Grid.Row="1" x:Name="LstGeneros" BorderThickness="0" Background="Transparent" Foreground="{StaticResource BrushTextMuted}"/>
            </Grid>
        </Border>

        <Button Grid.Row="3" Content="Voltar" Style="{StaticResource BtnOutline}" Width="100" Height="34" HorizontalAlignment="Right" Margin="0,16,0,0" Click="BtnVoltar_Click" IsCancel="True"/>
    </Grid>
</Window>
