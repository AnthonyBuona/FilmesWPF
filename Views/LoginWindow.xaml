<Window x:Class="FilmesWPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CineFlix Studio - Acesso" Height="530" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BrushBg}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho / Logo -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,24">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🎬 " FontSize="28" VerticalAlignment="Center"/>
                <TextBlock Text="CINEFLIX" FontSize="26" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="." FontSize="26" FontWeight="Black" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="STUDIO PRO • CONTROLE DE ACESSO" FontSize="10" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock Text="Informe suas credenciais para continuar" FontSize="13" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Formulário de Login -->
        <Border Grid.Row="1" Background="{StaticResource BrushCard}" CornerRadius="12" Padding="24" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <!-- Campo Usuário -->
                <TextBlock Text="Usuário *" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                <TextBox x:Name="TxtUsuario" Height="36" Margin="0,6,0,16"/>

                <!-- Campo Senha -->
                <TextBlock Text="Senha *" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                <PasswordBox x:Name="TxtSenha" Height="36" Margin="0,6,0,16"/>

                <!-- Mensagem de Erro -->
                <Border x:Name="BorderErro" Background="#3F121E" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="TxtErro" Text="Usuário ou senha inválidos." Foreground="#F87171" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Botão Entrar -->
                <Button x:Name="BtnEntrar" Content="Entrar no Sistema" Style="{StaticResource BtnPrimary}" Height="40" Margin="0,4,0,10" Click="BtnEntrar_Click" IsDefault="True"/>

                <!-- Botão Fechar -->
                <Button Content="Sair" Style="{StaticResource BtnOutline}" Height="34" Click="BtnSair_Click" IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- Dica de Acesso Padrão -->
        <Border Grid.Row="2" Background="#0C1322" CornerRadius="8" Padding="12,8" Margin="0,16,0,0" BorderBrush="#1A253E" BorderThickness="1">
            <TextBlock Text="💡 Acesso inicial: usuário 'admin' e senha '123'" 
                       FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
